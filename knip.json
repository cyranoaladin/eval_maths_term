{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "api/boot.ts",
    "db/migrate.ts",
    "db/seed.ts",
    "scripts/*.ts",
    "e2e/*.spec.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest.global-setup.ts",
    "eslint.config.js",
    "tailwind.config.js",
    "postcss.config.js",
    "vite.config.ts",
    "api/**/*.spec.ts"
  ],
  "project": [
    "api/**/*.ts",
    "src/**/*.{ts,tsx}",
    "contracts/**/*.ts",
    "db/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": [
    "db/migrations/**",
    "dist/**",
    "coverage/**"
  ],
  "ignoreBinaries": [
    "docker",
    "openssl",
    "pdftotext",
    "pdfinfo"
  ]
}
