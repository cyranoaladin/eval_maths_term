# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Identifiant de l'application
APP_SECRET=               # Secret applicatif (signature JWT) — 32 caractères minimum
PORT=3000

# ── Base de données ────────────────────────────────────────────
DATABASE_URL=             # mysql://user:pass@host:port/db

# ── Secrets de session (32 caractères minimum) ─────────────────
# Sans valeur, `env.ts` retombe sur des secrets de développement : à ne JAMAIS
# laisser en production, ils rendraient les jetons élève forgeables.
TEACHER_SESSION_SECRET=
STUDENT_SESSION_SECRET=

# ── Frontend (exposé au navigateur par Vite) ───────────────────
VITE_KIMI_AUTH_URL=       # URL du serveur OAuth Kimi (ex. https://auth.kimi.com)
VITE_APP_ID=              # Identifiant OAuth de l'application

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # URL du serveur OAuth Kimi (backend)
KIMI_OPEN_URL=            # URL de la plateforme Kimi Open (ex. https://open.kimi.com)

# ── Rôle administrateur ────────────────────────────────────────
OWNER_UNION_ID=           # Union ID du créateur : rôle "admin" à la première connexion

# ── Correction assistée par LLM ────────────────────────────────
# Sans LLM_API_KEY, les réponses ouvertes ne sont pas corrigées automatiquement :
# elles sont marquées « à corriger manuellement par l'enseignant ».
LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_API_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-5
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_MS=60000

# ── Recherche documentaire (RAG) ───────────────────────────────
# Sans RAG_URL, le port reste débranché : la génération fonctionne, mais sans
# ancrage sur vos supports de cours. Contrat visé : POST {RAG_URL}/search
# avec en-tête x-api-key et réponse de forme Chroma.
# RAG_URL=http://127.0.0.1:8011
# RAG_API_KEY=
RAG_COLLECTION=default
RAG_TIMEOUT_MS=10000

# ── Divers ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000   # Origines autorisées (CSRF), séparées par des virgules
LOG_LEVEL=info
BRAND_NAME=Évaluation Mathématiques Terminale
# REDIS_URL=
# SENTRY_DSN=
