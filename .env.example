# Contrat de configuration — copiez ce fichier en `.env` et renseignez-le.
#
# Ce fichier est la liste complète de ce que l'application lit. Il ne porte
# aucune valeur par défaut : celles-ci vivent dans `api/lib/env.ts`, et nulle
# part ailleurs. Une variable laissée vide ici prend donc la valeur que le
# code lui donne — ou fait échouer le démarrage si elle est requise.
#
# Un test (`api/__tests__/config/contrat-env.spec.ts`) vérifie que ce fichier,
# `api/lib/env.ts`, `docker-compose.yml` et `DEPLOYMENT.md` décrivent le même
# contrat. Ajouter une variable au code sans l'ajouter ici fait échouer la CI.
#
# En développement, n'écrivez pas ce fichier à la main :
#   scripts/bootstrap-dev.sh
# tire les secrets au hasard sur votre machine.

# ── Requis ─────────────────────────────────────────────────────
# Sans l'une de ces valeurs, l'application refuse de démarrer.

APP_ID=                   # Identifiant de l'application OAuth Kimi
APP_SECRET=               # Secret applicatif — 32 caractères minimum
TEACHER_SESSION_SECRET=   # Signature des sessions enseignant — 32 caractères minimum
STUDENT_SESSION_SECRET=   # Signature des sessions élève — 32 caractères minimum
DATABASE_URL=             # mysql://utilisateur:motdepasse@hôte:port/base
KIMI_AUTH_URL=            # Serveur OAuth Kimi (ex. https://auth.kimi.com)
KIMI_OPEN_URL=            # Plateforme Kimi Open (ex. https://open.kimi.com)
PUBLIC_BASE_URL=          # https://eval.etablissement.fr — requise en production

# `PUBLIC_BASE_URL` est l'adresse à laquelle on joint l'application, et la
# seule source de l'URL de redirection OAuth. Elle ne se déduit pas de la
# requête : l'en-tête `Host` vient du client, et derrière un reverse proxy qui
# le transmet sans le valider, il suffirait d'en changer pour détourner le code
# d'autorisation. Hors production, elle peut rester vide.

# Les trois secrets doivent être distincts les uns des autres, faire au moins
# 32 caractères, et ne ressembler à aucune valeur de remplissage. Générez-en :
#   openssl rand -base64 48

# ── Base de données conteneurisée ──────────────────────────────
# Lues par docker-compose.yml pour créer la base, et par
# docker-compose.dev.yml en développement. Le mot de passe applicatif doit
# être le même que celui de DATABASE_URL.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Serveur ────────────────────────────────────────────────────

NODE_ENV=                 # development | test | production
PORT=                     # défaut 3000
ALLOWED_ORIGINS=          # origines autorisées (CSRF), séparées par des virgules
LOG_LEVEL=                # debug | info | warn | error
DB_POOL_SIZE=             # 60 est l'optimum mesuré pour une classe entière ; voir RELEASE_EVIDENCE.md §9
PAPER_OUTPUT_DIR=         # racine des dossiers de tirage papier, hors du dépôt
REDIS_URL=
SENTRY_DSN=

# ── Rôle administrateur ────────────────────────────────────────

OWNER_UNION_ID=           # Union ID du propriétaire : seul compte administrateur d'origine

# ── Correction assistée par LLM ────────────────────────────────
# Sans LLM_API_KEY, les réponses ouvertes ne sont pas corrigées
# automatiquement : elles sont marquées « à corriger manuellement ».

LLM_API_KEY=
LLM_PROVIDER=
LLM_API_URL=
LLM_MODEL=
LLM_MAX_TOKENS=
LLM_TIMEOUT_MS=

# ── Recherche documentaire (RAG) ───────────────────────────────
# Sans RAG_URL, le port reste débranché : la génération fonctionne, mais sans
# ancrage sur vos supports de cours. Contrat visé : POST {RAG_URL}/search
# avec en-tête x-api-key et réponse de forme Chroma.

RAG_URL=
RAG_API_KEY=
RAG_COLLECTION=
RAG_TIMEOUT_MS=

# ── Kimi (facultatif) ──────────────────────────────────────────

KIMI_API_KEY=

# ── Marque ─────────────────────────────────────────────────────

BRAND_NAME=
BRAND_LOGO_URL=

# ── Exposées au navigateur ─────────────────────────────────────
# Vite les inline dans le bundle : n'y mettez jamais de secret.

VITE_APP_ID=                  # même valeur qu'APP_ID
VITE_KIMI_AUTH_URL=           # même valeur que KIMI_AUTH_URL
VITE_ETABLISSEMENT=           # mentions légales : sans ces valeurs, les pages
VITE_ETABLISSEMENT_ADRESSE=   # affichent « à compléter » plutôt que d'inventer
VITE_DIRECTEUR_PUBLICATION=   # un éditeur ou un contact
VITE_CONTACT_DONNEES=
VITE_HEBERGEUR=

# ── Tests ──────────────────────────────────────────────────────
# Base des tests d'intégration. Elle est effacée et reconstruite à chaque
# exécution : ne la faites jamais pointer sur une base qui contient des copies.

TEST_DATABASE_URL=
