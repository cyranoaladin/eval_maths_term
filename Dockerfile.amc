# syntax=docker/dockerfile:1
#
# Image de production **avec impression**.
#
# `auto-multiple-choice` tire une chaîne LaTeX complète : l'image dérivée pèse
# environ deux gigaoctets de plus. C'est le prix de l'impression des sujets, et
# c'est pourquoi l'image de base ne l'embarque pas — un établissement qui
# n'évalue qu'en ligne n'a aucune raison de le payer.
#
# Cette variante est celle que doit exercer la recette de mise en service : le
# gate exige une génération AMC réelle depuis le runtime destiné à la
# production, pas depuis la machine de développement.
#
#   docker build -t eval-maths:latest .
#   docker build -t eval-maths-amc:latest -f Dockerfile.amc .
ARG IMAGE_BASE=eval-maths:latest
FROM ${IMAGE_BASE}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      auto-multiple-choice \
      texlive-latex-extra \
      texlive-lang-french \
 && rm -rf /var/lib/apt/lists/*
USER evalapp

# Vérification à la construction : l'exécutable doit répondre, sinon l'image
# est inutile et il vaut mieux le savoir maintenant.
RUN auto-multiple-choice version | head -1
