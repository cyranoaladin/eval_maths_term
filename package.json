{
  "name": "atelier-qcm",
  "version": "1.0.0-rc2",
  "description": "Atelier de QCM de mathématiques : rédaction, passage en ligne ou sur papier, correction et export.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "npm --prefix tools/migrations run generate",
    "db:push": "npm --prefix tools/migrations run push",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "scan:image": "bash scripts/scan-image.sh",
    "e2e:visuel": "docker run --rm --network host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/app -w /app -e E2E_BASE_URL=${E2E_BASE_URL:-http://127.0.0.1:3200} -e E2E_COOKIE_ENSEIGNANT -e CI=1 mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e npx playwright test --project=visuel --retries=0",
    "e2e:visuel:references": "docker run --rm --network host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/app -w /app -e E2E_BASE_URL=${E2E_BASE_URL:-http://127.0.0.1:3200} -e E2E_COOKIE_ENSEIGNANT mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e npx playwright test --project=visuel --update-snapshots",
    "sbom:image": "bash scripts/sbom-image.sh",
    "gate:applicabilite": "node scripts/gate-applicabilite.mjs",
    "vex:generer": "node scripts/vex-generer.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/node": "^10.72.0",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.5",
    "idb-keyval": "^6.2.2",
    "jose": "6.1.3",
    "katex": "^0.16.47",
    "lru-cache": "^11.3.6",
    "lucide-react": "^0.562.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.110.0",
    "mysql2": "^3.14.1",
    "nanoid": "^6.0.1",
    "pdfkit": "^0.20.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@hono/vite-dev-server": "^0.19.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.26",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
